# ═══════════════════════════════════════════════════════════════════════
# Inmobiscrap — variables de entorno
# Copiar a .env y completar. NUNCA commitear el .env real.
# ═══════════════════════════════════════════════════════════════════════

# ── Entorno ─────────────────────────────────────────────────────────────
# Development = habilita Swagger, dashboard de Hangfire y /api/admin/subscriptions/*
ASPNETCORE_ENVIRONMENT=Development
# Solo se usa para el mapeo de puertos de docker-compose (host:8080)
API_PORT=5000

# ── Base de datos (PostgreSQL) ──────────────────────────────────────────
# Usadas por docker-compose para crear el contenedor postgres.
# OJO: si el volumen postgres_data ya existe, estos valores NO se re-aplican;
# deben coincidir con los que se usaron al crear la BD por primera vez.
POSTGRES_DB=inmobiscrap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
DB_PORT=5432
# Dentro de docker-compose el host es el nombre del servicio
DB_HOST=postgres

# Solo para correr con `dotnet run` fuera de Docker. Tiene prioridad sobre
# ConnectionStrings__DefaultConnection, así que déjalo comentado si usas Docker.
# DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=inmobiscrap;Username=postgres;Password=

# ── JWT (OBLIGATORIO) ───────────────────────────────────────────────────
# Mínimo 32 caracteres (HS256). Generar con: openssl rand -base64 48
# Cambiarlo invalida todas las sesiones activas.
JWT_SECRET=

# ── AWS Bedrock (OBLIGATORIO salvo SCRAPER_MOCK_MODE=true) ──────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# La región debe ser compatible con el modelo/perfil (un perfil "us." requiere región us-*)
AWS_REGION=us-east-1
# ID del modelo o perfil de inferencia (copiarlo desde la consola de Bedrock)
BEDROCK_MODEL_ID=
# true = no llama a Bedrock, devuelve una propiedad de prueba (permite arrancar sin AWS)
SCRAPER_MOCK_MODE=false

# ── Google OAuth ────────────────────────────────────────────────────────
# Client ID web (el mismo que usa el frontend). Si queda vacío, el login con
# Google responde 503 (no se puede validar a qué app pertenece el token).
GOOGLE_CLIENT_ID=

# ── Admins ──────────────────────────────────────────────────────────────
# Emails separados por coma que se promueven a admin + pro automáticamente.
# Solo aplica al iniciar sesión con GOOGLE (email verificado); registrarse con
# contraseña usando uno de estos emails NO da admin.
SUPERADMIN_EMAIL=

# ── Mercado Pago ────────────────────────────────────────────────────────
# Token que empieza con TEST- = sandbox
MP_ACCESS_TOKEN=
# Solo sandbox (se ignora si el token no es TEST-): email del comprador de prueba
MP_TEST_PAYER_EMAIL=
# URL pública del frontend (back_urls de MP + se agrega a CORS)
FRONTEND_URL=http://localhost:3000
# URL pública del backend (notification_url de MP: debe ser HTTPS accesible desde internet)
BACKEND_URL=http://localhost:5000

# ── SMTP (alertas de precio por email) ─────────────────────────────────
# Si SMTP_HOST o SMTP_USER están vacíos, los emails se omiten (solo warning).
# Usar puerto 587 (STARTTLS); System.Net.Mail no soporta SSL implícito en 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notificaciones@inmobiscrap.com
